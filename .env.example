# Copy to .env for local builds. On the host (Cloudflare Pages etc.) set these as build environment variables.
# Leave both unset to build with the sample menu from src/data/site.ts.

# The Apps Script web app's /exec URL (see google-sheet/README.md)
SHEET_API_URL=
# Same value as the API_KEY script property in the Sheet
SHEET_API_KEY=
