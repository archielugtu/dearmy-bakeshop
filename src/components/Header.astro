---
import { business } from '../data/site';
const links = [
  { href: '#bakes', label: 'Bakes' },
  { href: '#visit', label: 'Visit' },
  { href: '#order', label: 'Order' },
];
---

<header class="site-header">
  <a class="site-header__logo" href="#top" aria-label={`${business.name}, back to top`}>
    <img
      src="/logo-192.webp"
      srcset="/logo-96.webp 96w, /logo-192.webp 192w"
      sizes="(min-width: 700px) 84px, 60px"
      width="84"
      height="84"
      alt=""
    />
  </a>
  <nav class="site-header__nav" aria-label="Main">
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
  <a class="btn btn--small site-header__call" href={`tel:${business.phone.tel}`}>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
      <path
        d="M6 3h3l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v3a3 3 0 0 1-3 3A16 16 0 0 1 3 6a3 3 0 0 1 3-3z"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span class="site-header__call-word">Call</span>
    <span class="site-header__call-number">{business.phone.display}</span>
  </a>
</header>
