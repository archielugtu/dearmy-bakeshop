---
import '@fontsource-variable/grandstander';
// Latin subsets only: the full Gaegu family ships hundreds of Korean glyph files this page never needs.
import '@fontsource/gaegu/latin-400.css';
import '@fontsource/gaegu/latin-700.css';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import { business, seo } from '../data/site';

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: business.name,
  url: canonical.href,
  image: ogImage.href,
  telephone: business.phone.tel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressCountry: 'NZ',
  },
  // Placeholder opening hours are deliberately left out of structured data, and the
  // Instagram link is only included once it is real, so search engines never see unverified details.
  ...(business.instagram.isPlaceholder ? {} : { sameAs: [business.instagram.url] }),
};
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#FEF189" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Marks the page as script-enabled before first paint so reveal styles only apply when JS can undo them.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
